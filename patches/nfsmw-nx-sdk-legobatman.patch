+        double a = 0, b = 0;
+        if (when.find('+') != std::string::npos) {
+          a = std::atof(when.c_str());
+          b = std::atof(when.c_str() + when.find('+') + 1);
+          if (b > 0 && t >= a && std::fmod(t - a, b) < 0.15) buttons |= bit(what);
+        } else if (when.find('-', 1) != std::string::npos) {
+          a = std::atof(when.c_str());
+          b = std::atof(when.c_str() + when.find('-', 1) + 1);
+          if (t >= a && t < b) {
+            if (what == "up") ly = 32767; else if (what == "down") ly = -32767;
+            else if (what == "left") lx = -32767; else if (what == "right") lx = 32767;
+          }
+        } else {
+          a = std::atof(when.c_str());
+          if (t >= a && t < a + 0.15) buttons |= bit(what);
+        }
+      }
+      if (!any) { merged = {}; any = true; }
+      merged.gamepad.buttons = uint16_t(merged.gamepad.buttons) | buttons;
+      if (lx) merged.gamepad.thumb_lx = lx;
+      if (ly) merged.gamepad.thumb_ly = ly;
+      merged.packet_number = merged.packet_number + 1;
+    }
+  }
+  if (user_index == 0 && lb_dbg_input_on) {
+    if (!any) { merged = {}; any = true; }
+    merged.gamepad.buttons = uint16_t(merged.gamepad.buttons) | lb_dbg_buttons;
+    const int16_t lx = lb_dbg_lx, ly = lb_dbg_ly, rx = lb_dbg_rx, ry = lb_dbg_ry;
+    if (lx || ly) { merged.gamepad.thumb_lx = lx; merged.gamepad.thumb_ly = ly; }
+    if (rx || ry) { merged.gamepad.thumb_rx = rx; merged.gamepad.thumb_ry = ry; }
+    if (lb_dbg_lt) merged.gamepad.left_trigger = lb_dbg_lt;
+    if (lb_dbg_rt) merged.gamepad.right_trigger = lb_dbg_rt;
+    merged.packet_number = merged.packet_number + 1;
+  }
