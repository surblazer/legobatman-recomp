diff --git a/sdk/include/rex/thread/mutex.h b/sdk/include/rex/thread/mutex.h
index 6e5755a..9aa70b4 100644
--- a/sdk/include/rex/thread/mutex.h
+++ b/sdk/include/rex/thread/mutex.h
@@ -13,8 +13,35 @@
 
 #include <mutex>
 
+#include "rex/platform.h"
+
 namespace rex::thread {
 
+// Acquires a recursive mutex, spinning briefly in user space before blocking (LEGO Batman port).
+// On Horizon a contended mutex is handed over through the kernel (svcArbitrateLock) and the next owner must be
+// scheduled first; LEGO Batman's loader hammers NtSetEvent/NtClearEvent/NtReleaseSemaphore, which all take the
+// global critical region, and profiling showed game and GPU threads blocked there most of the time with the CPU
+// mostly idle. Holds are short, so a bounded spin on try_lock (a user-space CAS in libnx) usually wins the lock
+// without a kernel round trip. Other platforms keep a plain lock().
+// Locks m, spinning on try_lock first on Switch (see above). For code that pairs lock()/unlock() by hand.
+inline void LockAdaptive(std::recursive_mutex& m) {
+#if REX_PLATFORM_SWITCH
+  constexpr int kSpins = 4000;  // ~tens of microseconds on an A57
+  for (int i = 0; i < kSpins; ++i) {
+    if (m.try_lock()) {
+      return;
+    }
+    __asm__ __volatile__("yield");
+  }
+#endif
+  m.lock();
+}
+
+inline std::unique_lock<std::recursive_mutex> AcquireAdaptive(std::recursive_mutex& m) {
+  LockAdaptive(m);
+  return std::unique_lock<std::recursive_mutex>(m, std::adopt_lock);
+}
+
 // The global critical region mutex singleton.
 // This must guard any operation that may suspend threads or be sensitive to
 // being suspended such as global table locks and such.
@@ -62,12 +89,12 @@ class global_critical_region {
   // to keep an instance of global_critical_region near the members requiring
   // it to keep things readable.
   static std::unique_lock<std::recursive_mutex> AcquireDirect() {
-    return std::unique_lock<std::recursive_mutex>(mutex());
+    return AcquireAdaptive(mutex());
   }
 
   // Acquires a lock on the global critical section.
   inline std::unique_lock<std::recursive_mutex> Acquire() {
-    return std::unique_lock<std::recursive_mutex>(mutex());
+    return AcquireAdaptive(mutex());
   }
 
   // Acquires a deferred lock on the global critical section.
