+  // LEGO Batman port (testing): scripted input for player 0 from REX_INPUT_SCRIPT, so the debug host can reach
+  // gameplay unattended. Entries separated by commas:
+  //   T:btn        press btn for 0.15 s at T seconds after the first poll
+  //   T+P:btn      press btn every P seconds from T on
+  //   T-U:stick    hold the left stick (up/down/left/right) from T to U seconds
+  // Buttons: a b x y start back up down left right lb rb.
+  if (user_index == 0) {
+    static const char* script = std::getenv("REX_INPUT_SCRIPT");
+    if (script && *script) {
+      using clk = std::chrono::steady_clock;
+      static const clk::time_point t0 = clk::now();
+      const double t = std::chrono::duration<double>(clk::now() - t0).count();
+      uint16_t buttons = 0;
+      int16_t lx = 0, ly = 0;
+      auto bit = [](const std::string& n) -> uint16_t {
+        static const std::pair<const char*, uint16_t> names[] = {
+            {"up", 0x1}, {"down", 0x2}, {"left", 0x4}, {"right", 0x8}, {"start", 0x10}, {"back", 0x20},
+            {"lb", 0x100}, {"rb", 0x200}, {"a", 0x1000}, {"b", 0x2000}, {"x", 0x4000}, {"y", 0x8000}};
+        for (auto& e : names) if (n == e.first) return e.second;
+        return 0;
+      };
+      std::string all(script);
+      size_t pos = 0;
+      while (pos <= all.size()) {
+        size_t end = all.find(',', pos);
+        if (end == std::string::npos) end = all.size();
+        const std::string e = all.substr(pos, end - pos);
+        pos = end + 1;
+        const size_t colon = e.find(':');
+        if (colon == std::string::npos) continue;
