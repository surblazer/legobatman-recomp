# Switch build environment for the LEGO Batman port: Ubuntu 24.04 (the setup nfsmw-nx documents in
# docs/building-linux.md) + devkitPro (devkitA64, libnx, portlibs) from the official image + Mesa build deps.
# Build:  podman build -t legobatman-switch-env tools/switch-env
FROM docker.io/devkitpro/devkita64:latest AS dkp

FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git cmake ninja-build python3 python3-pip python3-venv python3-numpy pkg-config \
      clang-20 lld-20 libx11-xcb-dev libxtst-dev libwayland-dev \
      python3-mako python3-yaml bison flex zlib1g-dev libzstd-dev libexpat1-dev \
      llvm-18-dev libclang-18-dev libclc-18-dev libllvmspirvlib-18-dev spirv-tools glslang-tools \
      build-essential file xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=dkp /opt/devkitpro /opt/devkitpro
ENV DEVKITPRO=/opt/devkitpro DEVKITA64=/opt/devkitpro/devkitA64
ENV PATH=/opt/devkitpro/devkitA64/bin:/opt/devkitpro/tools/bin:$PATH

# Meson >= 1.4 (Ubuntu 24.04 ships 1.3)
RUN python3 -m venv /opt/pymeson && /opt/pymeson/bin/pip install --no-cache-dir meson \
    && ln -s /opt/pymeson/bin/meson /usr/local/bin/meson

# Rust with the target Mesa's Rust code is built for, plus bindgen and cbindgen
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain stable \
    && rustup target add aarch64-unknown-linux-gnu \
    && cargo install --locked bindgen-cli cbindgen \
    && rm -rf /opt/cargo/registry /opt/cargo/git
